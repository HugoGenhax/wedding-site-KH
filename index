  var VOTES_KEY = 'kh-photo-votes';   // shared across everyone
  var MINE_KEY  = 'kh-my-vote';       // just yours
  var STORY_KEY = 'kh-stories';       // shared across everyone

  /* ---- storage adapter ---- */
  var mem = {};
  var hasStore = (typeof window !== 'undefined' && window.storage && typeof window.storage.get === 'function');
  var store = {
    get: function(k, shared){
      if(hasStore){
        return window.storage.get(k, !!shared)
          .then(function(r){ return r ? JSON.parse(r.value) : null; })
          .catch(function(){ return null; });
      }
      return Promise.resolve(k in mem ? mem[k] : null);
    },
    set: function(k, v, shared){
      mem[k] = v;
      if(hasStore){
        return window.storage.set(k, JSON.stringify(v), !!shared).catch(function(){});
      }
      return Promise.resolve();
    }
  };

  var votes = {};      // {index: count}
  var myVote = null;   // index
  var stories = [];

  var mosaic    = document.getElementById('mosaic');
  var standings = document.getElementById('standings');
  var standRows = document.getElementById('standRows');
  var lb        = document.getElementById('lb');
  var lbMedia   = document.getElementById('lbMedia');
  var lbStory   = document.getElementById('lbStory');
  var lbVote    = document.getElementById('lbVote');
  var lbTally   = document.getElementById('lbTally');
  var current   = 0;

  function esc(t){
    return String(t).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function pad(n){ return (n < 10 ? '0' : '') + n; }

  /* ---- mosaic ---- */
  function drawMosaic(){
    mosaic.innerHTML = PHOTOS.map(function(ph, i){
      var inner = ph.src
        ? '<img src="' + esc(ph.src) + '" alt="Katie and Hugo, picture ' + (i+1) + '">'
        : '<span class="tile__ph">Photo ' + (i+1) + '<br>square &middot; 1200 &times; 1200</span>';
      var badge = (myVote === i) ? '<span class="tile__badge">Your pick</span>' : '';
      return '<button class="tile" type="button" data-i="' + i + '" aria-label="Open picture ' + (i+1) + '">'
           + inner + '<span class="tile__n">' + pad(i+1) + '</span>' + badge + '</button>';
    }).join('');
  }

  /* ---- standings ---- */
  function drawStandings(){
    if(myVote === null){ standings.hidden = true; return; }
    standings.hidden = false;
    var rows = PHOTOS.map(function(ph, i){ return {i:i, n: votes[i] || 0}; })
                     .sort(function(a,b){ return b.n - a.n || a.i - b.i; });
    var top = Math.max(1, rows[0].n);
    standRows.innerHTML = rows.map(function(r, rank){
      return '<div class="stand__row' + (r.i === myVote ? ' is-mine' : '') + '">'
        + '<span class="stand__rank">' + pad(rank+1) + '</span>'
        + '<span class="stand__bar"><i style="width:' + Math.round(r.n / top * 100) + '%"></i></span>'
        + '<span class="stand__n">' + r.n + (r.i === myVote ? ' &middot; you' : '') + '</span>'
        + '</div>';
    }).join('');
  }

  /* ---- lightbox ---- */
  function openLb(i){
    current = i;
    var ph = PHOTOS[i];
    lbMedia.innerHTML = ph.src
      ? '<img src="' + esc(ph.src) + '" alt="Katie and Hugo, picture ' + (i+1) + '">'
      : '<div class="lb__ph">Photo ' + (i+1) + ' goes here</div>';
    lbStory.textContent = ph.story || '';
    paintVote();
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    lbVote.focus();
  }
  function closeLb(){
    lb.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  function paintVote(){
    var mine = (myVote === current);
    lbVote.textContent = mine ? 'This is your pick' : 'Vote for this one';
    lbVote.classList.toggle('is-mine', mine);
    lbTally.innerHTML = (myVote === null)
      ? 'Votes stay hidden until you pick one'
      : (votes[current] || 0) + (votes[current] === 1 ? ' vote' : ' votes');
  }
  function castVote(){
    if(myVote === current) return;
    if(myVote !== null) votes[myVote] = Math.max(0, (votes[myVote] || 1) - 1);
    votes[current] = (votes[current] || 0) + 1;
    myVote = current;
    paintVote(); drawMosaic(); drawStandings();
    store.set(VOTES_KEY, votes, true);
    store.set(MINE_KEY, myVote, false);
  }

  mosaic.addEventListener('click', function(e){
    var t = e.target.closest('.tile');
    if(t) openLb(parseInt(t.dataset.i, 10));
  });
  lbVote.addEventListener('click', castVote);
  document.getElementById('lbClose').addEventListener('click', closeLb);
  document.getElementById('lbPrev').addEventListener('click', function(){ openLb((current + PHOTOS.length - 1) % PHOTOS.length); });
  document.getElementById('lbNext').addEventListener('click', function(){ openLb((current + 1) % PHOTOS.length); });
  lb.addEventListener('click', function(e){ if(e.target === lb) closeLb(); });
  document.addEventListener('keydown', function(e){
    if(!lb.classList.contains('is-open')) return;
    if(e.key === 'Escape') closeLb();
    if(e.key === 'ArrowLeft') openLb((current + PHOTOS.length - 1) % PHOTOS.length);
    if(e.key === 'ArrowRight') openLb((current + 1) % PHOTOS.length);
  });

  /* ---- story wall ---- */
  var wall = document.getElementById('storyWall');
  function drawWall(){
    if(!stories.length){
      wall.innerHTML = '<p class="story__empty">No stories yet. Someone has to go first.</p>';
      return;
    }
    wall.innerHTML = stories.slice().reverse().map(function(st){
      return '<article class="story"><p>&ldquo;' + esc(st.text) + '&rdquo;</p>'
           + '<footer>' + esc(st.name || 'Anonymous') + '</footer></article>';
    }).join('');
  }
  document.getElementById('storyBtn').addEventListener('click', function(){
    var name = document.getElementById('s-name').value.trim();
    var text = document.getElementById('s-text').value.trim();
    var note = document.getElementById('storyNote');
    note.hidden = false;
    if(text.length < 10){ note.textContent = 'A few more words than that.'; return; }
    stories.push({ name:name, text:text, ts:Date.now() });
    if(stories.length > 200) stories = stories.slice(-200);
    document.getElementById('s-text').value = '';
    note.textContent = 'Added. Everyone visiting this page can read it, so keep it kind.';
    drawWall();
    store.set(STORY_KEY, stories, true);
  });

  /* ---- boot ---- */
  drawMosaic(); drawWall();
  Promise.all([ store.get(VOTES_KEY, true), store.get(MINE_KEY, false), store.get(STORY_KEY, true) ])
    .then(function(r){
      votes   = r[0] || {};
      myVote  = (typeof r[1] === 'number') ? r[1] : null;
      stories = Array.isArray(r[2]) ? r[2] : [];
      drawMosaic(); drawStandings(); drawWall();
    });
})();
</script>
</body>
</html>
