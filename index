<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var overture = document.querySelector('.overture');
  var envLayer = document.getElementById('envLayer');
  var flap     = document.getElementById('envFlap');
  var seal     = document.getElementById('seal');
  var card     = document.getElementById('envCard');
  var photo    = document.getElementById('heroPhoto');
  var veil     = document.getElementById('heroVeil');
  var plate    = document.getElementById('heroPlate');
  var names    = document.getElementById('heroNames');
  var cue      = document.getElementById('cue');
  var nav      = document.getElementById('nav');

  function clamp(v,a,b){ return v<a?a:(v>b?b:v); }
  function seg(p,a,b){ return clamp((p-a)/(b-a),0,1); }          // 0→1 across a range
  function ease(t){ return t<.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2; }

  function paint(){
    if(reduce){ finish(); return; }

    var rect = overture.getBoundingClientRect();
    var span = overture.offsetHeight - window.innerHeight;
    var p = clamp(-rect.top / span, 0, 1);

    // 1. the flap swings open
    var open = ease(seg(p, .04, .34));
    flap.style.transform = 'rotateX(' + (-176 * open) + 'deg)';
    flap.style.zIndex = open > .5 ? 0 : 6;
    seal.style.opacity = String(clamp(1 - open*2.4, 0, 1));
    seal.style.transform = 'translate(-50%,-50%) scale(' + (1 - .25*open) + ')';
    card.style.transform = 'translateY(' + (6 - 5*open) + '%)';
    card.style.opacity = String(clamp(open*1.6, 0, 1));

    // 2. the whole envelope slides down and out
    var drop = ease(seg(p, .30, .70));
    envLayer.style.transform = 'translate3d(0,' + (drop*118) + 'vh,0) scale(' + (1 - .06*drop) + ')';
    envLayer.style.opacity = String(clamp(1 - seg(p,.60,.74), 0, 1));

    // 3. the photo comes up behind it
    var pic = ease(seg(p, .26, .62));
    photo.style.opacity = String(pic);
    photo.style.transform = 'scale(' + (1.1 - .1*pic) + ')';
    veil.style.opacity = String(ease(seg(p,.34,.68)) * .95);

    // 4. the names settle in gold
    var nm = ease(seg(p, .50, .84));
    plate.style.opacity = String(nm);
    names.style.transform = 'translateY(' + (26 - 26*nm) + 'px)';
    names.style.letterSpacing = (0.42 - 0.32*nm).toFixed(3) + 'em';

    cue.style.opacity = String(clamp(1 - p*5, 0, 1));
    nav.classList.toggle('is-on', p > .92);
  }

  function finish(){
    flap.style.transform = 'rotateX(-176deg)';
    envLayer.style.opacity = '0';
    photo.style.opacity = '1';
    photo.style.transform = 'none';
    veil.style.opacity = '.95';
    plate.style.opacity = '1';
    names.style.letterSpacing = '.1em';
    nav.classList.add('is-on');
  }

  /* nav folds away on the way down, returns on the way up */
  var links  = document.getElementById('navLinks');
  var toggle = document.getElementById('navToggle');
  var lastY = window.scrollY || 0, navHidden = false;
  function shutMenu(){ links.classList.remove('is-open'); toggle.setAttribute('aria-expanded','false'); }
  function navScroll(){
    var y = window.scrollY || 0;
    if(!nav.classList.contains('is-on')){ lastY = y; return; }
    if(y > lastY + 8 && y > 320){
      if(!navHidden){ nav.classList.add('is-hidden'); shutMenu(); navHidden = true; }
    } else if(y < lastY - 8){
      if(navHidden){ nav.classList.remove('is-hidden'); navHidden = false; }
    }
    lastY = y;
  }
  toggle.addEventListener('click', function(){
    var open = links.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  links.addEventListener('click', function(e){ if(e.target.tagName === 'A') shutMenu(); });

  var queued = false;
  function onScroll(){
    if(queued) return;
    queued = true;
    requestAnimationFrame(function(){ paint(); navScroll(); queued = false; });
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  paint();

  // section reveals
  if(!reduce && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, {threshold:.18});
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('is-in'); });
  }

  // RSVP → opens the guest's mail app until you connect a form service
  document.getElementById('rsvpBtn').addEventListener('click', function(){
    var name = document.getElementById('r-name').value.trim();
    var note = document.getElementById('rsvpNote');
    if(!name){ note.hidden = false; note.textContent = 'Add your name first, then send.'; return; }
    var body = 'Name: ' + name
      + '\nResponse: ' + document.getElementById('r-attend').value
      + '\nWednesday drinks: ' + document.getElementById('r-drinks').value
      + '\nFriday brunch: ' + document.getElementById('r-brunch').value
      + '\nParty size: ' + document.getElementById('r-guests').value
      + '\nNotes: ' + document.getElementById('r-notes').value;
    window.location.href = 'mailto:hello@katieandhugo.com?subject='
      + encodeURIComponent('RSVP — ' + name) + '&body=' + encodeURIComponent(body);
    note.hidden = false;
    note.textContent = 'Opening your mail app. If nothing happens, send the same details to hello@katieandhugo.com.';
  });
})();
</script>

